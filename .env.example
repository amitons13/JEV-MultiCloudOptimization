# ---- FinGuard.ai : Jev model via OpenRouter ----
# Get a key at https://openrouter.ai/keys and paste it below, then
# copy this file to ".env"  (cp .env.example .env)

OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Triage engine selection (config-only, not exposed in the UI):
#   simulation -> always use the built-in deterministic engine (no API calls)
#   live       -> always call the real Jev model via OpenRouter (needs a valid key)
#   auto       -> live when a valid key is set above, otherwise simulation
JEV_MODE=auto

# The "Jev" fast System-One decision model — TypeSafe Jev Router on OpenRouter.
# This is the real Jev model (System One) used for split-second classification.
JEV_MODEL=typesafe/jev-router

# Optional: the "slow reasoning" model used for low-confidence deep analysis
REASONING_MODEL=anthropic/claude-3.5-sonnet

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=https://finguard.ai
OPENROUTER_APP_NAME=FinGuard.ai
